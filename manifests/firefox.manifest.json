{
  "manifest_version": 2,
  "name": "Give Me Doc",
  "version": "1.0.0",
  "description": "将 AI 对话导出为 Word 文档 — 由 Pandoc WASM 驱动",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardRead",
    "https://chat.deepseek.com/*",
    "https://www.doubao.com/chat/*",
    "https://pandoc.org/*",
    "https://cdn.jsdelivr.net/*",
    "https://cdn.jsdmirror.com/*"
  ],
  "browser_action": {
    "default_popup": "src/extension-popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*", "https://www.doubao.com/chat/*"],
      "js": ["content.js"],
      "css": ["assets/style.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "pandoc.worker.js",
    "pandoc.wasm"
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self' blob:",
  "browser_specific_settings": {
    "gecko": {
      "id": "give-me-doc@Qalxry",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
